{
  "manifest_version": 3,
  "name": "Noema",
  "version": "0.1.1",
  "description": "Work across the web with your Noema workspace, reviewed actions and local controls.",
  "permissions": [
    "sidePanel",
    "activeTab",
    "contextMenus",
    "tabs",
    "scripting",
    "storage",
    "webNavigation",
    "debugger",
    "alarms",
    "offscreen"
  ],
  "host_permissions": [
    "https://app.noemanetwork.xyz/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' data: blob:;"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.noemanetwork.xyz/*"
      ],
      "js": [
        "src/noema/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "src/ui/sidepanel.html",
  "action": {
    "default_title": "Noema",
    "default_icon": {
      "96": "src/noema/icons/icon-96.png",
      "192": "src/noema/icons/icon-192.png",
      "512": "src/noema/icons/icon-512.png"
    }
  },
  "icons": {
    "96": "src/noema/icons/icon-96.png",
    "192": "src/noema/icons/icon-192.png",
    "512": "src/noema/icons/icon-512.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+W"
      },
      "description": "Open Noema panel"
    }
  },
  "web_accessible_resources": [],
  "minimum_chrome_version": "116",
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
